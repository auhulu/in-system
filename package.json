{
  "name": "in-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vite",
    "build": "node scripts/prepare-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "vite preview",
    "deploy": "yarn build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ./src ./scripts ./vite.config.ts",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@mantine/core": "8.2.5",
    "@mantine/hooks": "8.2.5",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@tabler/icons-react": "^3.34.1",
    "@tanstack/react-query": "^5.85.5",
    "kuromoji": "^0.1.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sql.js": "1.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/workers-types": "5.20261005.1",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "22.13.11",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "6.1.1",
    "postcss": "^8.5.3",
    "postcss-preset-mantine": "1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "5.8.2",
    "vite": "8.3.2",
    "wrangler": "4.147.0"
  },
